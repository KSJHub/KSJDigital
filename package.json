{
  "name": "ksjdigital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --import ./server/runtimeGlobals.js server/start.js\" \"node scripts/start-client-editors.mjs\"",
    "frontend": "vite",
    "server": "node --import ./server/runtimeGlobals.js server/start.js",
    "client-editors": "node scripts/start-client-editors.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "check:server": "node scripts/check-server.mjs",
    "check:publication": "node scripts/check-publication-boundary.mjs",
    "check:workspace": "node scripts/check-workspace-boundary.mjs",
    "check:data": "node scripts/check-data-integrity.mjs",
    "check:auth": "node scripts/check-auth-hardening.mjs",
    "check:credentials": "node scripts/check-credential-storage.mjs",
    "check:sessions": "node scripts/check-session-security.mjs",
    "check:origins": "node scripts/check-trusted-origins.mjs",
    "check:capabilities": "node scripts/check-website-capabilities.mjs",
    "check:capability-api": "node scripts/check-capability-api-boundary.mjs",
    "check:services": "node scripts/check-service-layer.mjs",
    "check:content-service": "node scripts/check-content-service.mjs",
    "check:dynamic-content": "node scripts/check-dynamic-content.mjs",
    "check:content-workflow": "node scripts/check-content-workflow.mjs",
    "check:content-search": "node scripts/check-content-search.mjs",
    "check:asset-library": "node scripts/check-asset-library.mjs",
    "check:taxonomy": "node scripts/check-taxonomy.mjs",
    "check:localisation": "node scripts/check-localisation.mjs",
    "check:audit-trail": "node scripts/check-audit-trail.mjs",
    "check:integrations": "node scripts/check-integrations.mjs",
    "check:automations": "node scripts/check-automations.mjs",
    "check:system-health": "node scripts/check-system-health.mjs",
    "check:backups": "node scripts/check-backups.mjs",
    "check:configuration": "node scripts/check-configuration.mjs",
    "check:releases": "node scripts/check-releases.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:components": "node scripts/check-component-registry.mjs",
    "check:component-inspector": "node scripts/check-component-inspector.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check": "npm run lint && npm run check:server && npm run check:publication && npm run check:workspace && npm run check:data && npm run check:auth && npm run check:credentials && npm run check:sessions && npm run check:origins && npm run check:capabilities && npm run check:capability-api && npm run check:services && npm run check:content-service && npm run check:dynamic-content && npm run check:content-workflow && npm run check:content-search && npm run check:asset-library && npm run check:taxonomy && npm run check:localisation && npm run check:audit-trail && npm run check:integrations && npm run check:automations && npm run check:system-health && npm run check:backups && npm run check:configuration && npm run check:releases && npm run check:migrations && npm run check:components && npm run check:component-inspector && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.0.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "0.468.0",
    "clsx": "2.1.1",
    "express": "4.21.2",
    "cors": "2.8.5",
    "multer": "1.4.5-lts.1",
    "concurrently": "9.2.1"
  },
  "devDependencies": {
    "eslint": "10.3.0",
    "@eslint/js": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "prettier": "3.4.2"
  }
}