# KSJ Digital API
PORT=4174
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Protected portal login credentials
# Set strong unique values on the server. Never commit the real passwords.
KSJ_OWNER_PASSWORD=replace-with-owner-password
TWOTONETAJ_CLIENT_PASSWORD=replace-with-client-password
GOLIATH_CLIENT_PASSWORD=replace-with-client-password

# Frontend API URLs
VITE_KSJ_API_URL=http://localhost:4174/api
VITE_KSJ_ASSET_URL=http://localhost:4174

# Local development only
# Never enable this in a production build.
VITE_KSJ_DEV_BYPASS_AUTH=false

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=https://twotonetaj.ksjdigital.co.uk/merch/success
STRIPE_CANCEL_URL=https://twotonetaj.ksjdigital.co.uk/merch/cancelled

# PayPal sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me
PAYPAL_BRAND_NAME=TwoToneTaj Merch
PAYPAL_RETURN_URL=https://twotonetaj.ksjdigital.co.uk/merch/paypal-return
PAYPAL_CANCEL_URL=https://twotonetaj.ksjdigital.co.uk/merch/cancelled

# Transactional email
RESEND_API_KEY=re_replace_me
ORDER_EMAIL_FROM=TwoToneTaj Merch <orders@ksjdigital.co.uk>

# Order management
ORDER_MANAGE_URL=https://ksjdigital.co.uk/owner/orders
