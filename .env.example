############################################################
# KSJ DIGITAL — Environment Template
#
# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local, passwords, API keys, or webhooks.
############################################################

# Server
PORT=4174
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# Frontend API URLs — local development
VITE_KSJ_API_URL=http://localhost:4174/api
VITE_KSJ_ASSET_URL=http://localhost:4174
VITE_KSJ_DEV_BYPASS_AUTH=false

# Protected portal credentials
KSJ_OWNER_PASSWORD=replace-with-owner-password
TWOTONETAJ_CLIENT_PASSWORD=replace-with-client-password
GOLIATH_CLIENT_PASSWORD=replace-with-client-password

# Stripe — test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=https://store.example.com/merch/success
STRIPE_CANCEL_URL=https://store.example.com/merch/cancelled

# PayPal — sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me
PAYPAL_BRAND_NAME=Example Store
PAYPAL_RETURN_URL=https://store.example.com/merch/paypal-return
PAYPAL_CANCEL_URL=https://store.example.com/merch/cancelled

# Transactional email — Resend
RESEND_API_KEY=re_replace_me
ORDER_EMAIL_FROM=Example Store <orders@example.com>

# Order management
ORDER_MANAGE_URL=https://admin.example.com/owner/orders

# Discord order webhooks are saved per website in Commerce Settings.
